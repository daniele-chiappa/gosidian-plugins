{
  "name": "gosidian-claude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A gosidian plugin whose node runs Claude Code headless on the files a pipeline hands it",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
