{
  "name": "gosidian-preview",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A gosidian plugin that serves the static build of a branch at an address that expires, and tries it with a Playwright server",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "ajv": "8.20.0",
    "playwright-core": "1.64.0",
    "yauzl": "3.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/yauzl": "3.4.0",
    "typescript": "7.0.2"
  }
}
